generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // directUrl = env("DIRECT_URL")
}

// ========================================
// ========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_idx")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  email   String   @id
  token   String   @unique
  expires DateTime

  @@map("password_reset_tokens")
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  oldEmail  String   @map("old_email")
  newEmail  String   @map("new_email")
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([newEmail])
  @@map("email_change_tokens")
}

model Passkey {
  id     String @id @default(cuid()) @db.VarChar(25)
  userId String @db.VarChar(25)

  credentialId String @unique @map("credential_id") @db.VarChar(500) // Base64URL encoded
  publicKey    Bytes  @map("public_key") // COSE public key
  counter      BigInt @default(0)

  transports String? @db.VarChar(200) // JSON array: ["internal", "hybrid", "usb", etc.]
  deviceType String? @map("device_type") @db.VarChar(50) // platform, cross-platform
  backedUp   Boolean @default(false) @map("backed_up")

  name String? @db.VarChar(100)

  kind String @default("passkey") @db.VarChar(20)

  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model EmailResendAttempt {
  id        String   @id @default(cuid())
  email     String
  attemptAt DateTime @default(now())

  @@index([email, attemptAt])
  @@map("email_resend_attempts")
}

// ========================================
// ========================================

model Zki {
  id        Int      @id @default(autoincrement())
  masterKey String   @map("master_key") @db.VarChar(64)
  memo      String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  users User[]

  @@map("zki")
}

// ========================================
// ========================================

model User {
  id                String    @id @default(cuid()) @db.VarChar(25)
  name              String?
  email             String?   @unique
  emailVerified     DateTime?
  image             String?
  password          String?
  last_login_at     DateTime? @updatedAt
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  encryptedDataKey  Bytes?    @db.ByteA
  zkiId             Int?      @map("zki_id")
  isAnonymized      Boolean   @default(false) @map("is_anonymized")
  anonymizedAt      DateTime? @map("anonymized_at")
  signupFingerprint String?   @map("signup_fingerprint")
  signupIp          String?   @map("signup_ip")

  zki                       Zki?                       @relation(fields: [zkiId], references: [id])
  accounts                  Account[]
  passkeys                  Passkey[]
  agents                    Agent[]
  aiProviders               AiProviders?
  ragProviders              RagProviders?
  cpaLedger                 CpaLedger[]
  settings                  Settings?
  subscription              Subscription?
  billingInfo               BillingInfo?
  invoices                  Invoice[]
  blogPosts                 BlogPost[]
  uploadedMedia             BlogMedia[]
  anonymizationRequests     AnonymizationRequest[]
  invoicePlanChangeSchedule InvoicePlanChangeSchedule?
  workflowConnections       WorkflowConnection[]
  analyticsConfig           AnalyticsConfig?
  botChannels               BotChannel[]
  callPhoneNumbers          CallPhoneNumber[]
  callSessions              CallSession[]
  webVisitorContacts        WebVisitorContact[]
  bookingIndexes            BookingIndex[]
  appRefreshTokens          AppRefreshToken[]
  miniAppPayloads           MiniAppPayload[]
  miniAppAssignments        MiniAppAssignment[]
  appPushTokens             AppPushToken[]
  mcpAccessTokens           McpAccessToken[]
  mcpDeployRequests         McpDeployRequest[]
  vatFxRatesManual          VatFxRateManual[]
  workProjects              WorkProject[]
  workEvents                WorkEvent[]

  @@map("user")
}

model McpAccessToken {
  id              String    @id @default(cuid()) @db.VarChar(25)
  userId          String    @map("user_id") @db.VarChar(25)
  name            String    @db.VarChar(100)
  tokenHash       String    @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex
  tokenPrefix     String    @map("token_prefix") @db.VarChar(16)
  scopes          String    @default("read") @db.VarChar(50)
  lastUsedAt      DateTime? @map("last_used_at")
  lastUsedIp      String?   @map("last_used_ip") @db.VarChar(45)
  lastUsedCountry String?   @map("last_used_country") @db.VarChar(2)
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mcp_access_token")
}

model McpAuditLog {
  id         String   @id @default(cuid()) @db.VarChar(25)
  tokenId    String   @map("token_id") @db.VarChar(25)
  userId     String   @map("user_id") @db.VarChar(25)
  tool       String   @db.VarChar(60)
  ok         Boolean
  code       String?  @db.VarChar(60)
  workflowId String?  @map("workflow_id") @db.VarChar(25)
  durationMs Int      @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tokenId, createdAt])
  @@index([userId, createdAt])
  @@map("mcp_audit_log")
}

model McpRateBucket {
  id          Int      @id @default(autoincrement())
  tokenId     String   @map("token_id") @db.VarChar(25)
  class       String   @db.VarChar(10)
  windowStart DateTime @map("window_start")
  count       Int      @default(1)

  @@unique([tokenId, class, windowStart])
  @@index([windowStart])
  @@map("mcp_rate_bucket")
}

//
model McpDeployRequest {
  id             String    @id @default(cuid()) @db.VarChar(25)
  userId         String    @map("user_id") @db.VarChar(25)
  tokenId        String    @map("token_id") @db.VarChar(25)
  workflowId     String    @map("workflow_id") @db.VarChar(25)
  agentId        String    @map("agent_id") @db.VarChar(20)
  targetVersion  Int       @map("target_version")
  targetJsonHash String    @map("target_json_hash") @db.VarChar(64)
  status         String    @default("pending") @db.VarChar(20)
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  approvedById   String?   @map("approved_by_id") @db.VarChar(25)
  approvedAt     DateTime? @map("approved_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([workflowId])
  @@map("mcp_deploy_request")
}

model AppRefreshToken {
  id            String       @id @default(cuid()) @db.VarChar(25)
  userId        String?      @map("user_id") @db.VarChar(25)
  agentMemberId Int?         @map("agent_member_id")
  tokenHash     String       @unique @map("token_hash") @db.VarChar(64) // SHA-256 hex
  expiresAt     DateTime     @map("expires_at")
  revokedAt     DateTime?    @map("revoked_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  user          User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  member        AgentMember? @relation(fields: [agentMemberId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([agentMemberId])
  @@map("app_refresh_token")
}

// ========================================
// ========================================

model Settings {
  id                 String   @id @db.VarChar(25)
  timezone           String   @default("UTC") @db.VarChar(50)
  locale             String   @default("en-US") @db.VarChar(10)
  time_format        String   @default("MM-DD-YYYY HH:mm") @db.VarChar(50)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  plan               String   @default("free") @db.VarChar(20)
  api_key_configured Boolean  @default(false) @map("api_key_configured")

  // Secret Vault
  vaultEnabled   Boolean @default(false) @map("vault_enabled")
  vaultUrl       String? @map("vault_url") @db.VarChar(500)
  vaultAuthToken String? @map("vault_auth_token") @db.Text

  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  onboardingProfile     Json?     @map("onboarding_profile")

  accountType AccountType? @map("account_type")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ========================================
// ========================================

model AnalyticsConfig {
  id            Int      @id @default(autoincrement())
  userId        String   @unique @map("user_id") @db.VarChar(25)
  measurementId String   @map("measurement_id") @db.VarChar(20) // GA4 Measurement ID (G-XXXXXXXXXX)
  apiSecret     String   @map("api_secret") @db.Text
  isEnabled     Boolean  @default(true) @map("is_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("analytics_config")
}

// ========================================
// ========================================

model AiProviders {
  id String @id @db.VarChar(25) // userId

  // {
  //   "openai": { "apiKey": "encrypted...", "orgId": "org-xxx" },
  //   "gemini": { "apiKey": "encrypted..." },
  //   "claude": { "apiKey": "encrypted..." },
  //   "deepseek": { "apiKey": "encrypted..." },
  //   "grok": { "apiKey": "encrypted..." }
  // }
  providers String? @db.Text

  defaultProvider String @default("openai") @map("default_provider") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("ai_providers")
}

// ========================================
// ========================================

model RagProviders {
  id String @id @db.VarChar(25) // userId

  // {
  //   "openai_vector_store": { "enabled": true, "linkedLlm": "openai" },
  //   "gemini_file_search": { "enabled": true, "linkedLlm": "gemini" },
  //   "pinecone": { "enabled": true, "apiKey": "encrypted...", "host": "xxx.pinecone.io", "embedding": {...} },
  //   "qdrant": { "enabled": false, "host": "localhost:6333", "embedding": {...} }
  // }
  providers String? @db.Text

  defaultProvider String @default("openai_vector_store") @map("default_provider") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("rag_providers")
}

// ========================================
// ========================================

model RagStore {
  id      String @id @default(cuid()) @db.VarChar(25)
  agentId String @db.VarChar(20)

  provider String @db.VarChar(50) // openai_vector_store, pinecone, qdrant, ...

  externalId String @map("external_id") @db.VarChar(100)

  name String @db.VarChar(200)

  // { "dimension": 1536, "metric": "cosine", "recordCount": 1000 }
  metadata String? @db.Text

  status String @default("active") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@unique([agentId, provider])
  @@index([agentId])
  @@map("rag_stores")
}

// ========================================
// ========================================

model Subscription {
  id String @id @db.VarChar(25)

  planType     SubscriptionPlan @default(free) @map("plan_type")
  billingCycle BillingCycle?    @map("billing_cycle")

  status SubscriptionStatus @default(active)

  platform      PaymentPlatform?
  paymentMethod PaymentMethod?   @map("payment_method")

  start_date DateTime @default(now())
  end_date   DateTime

  free_cpa   Int @default(50)
  free_total Int @default(50)
  paid_cpa   Int @default(0)
  paid_total Int @default(0)

  month Int @default(1)

  partnerProgramId String? @map("partner_program_id") @db.VarChar(25)

  trialEndsAt          DateTime? @map("trial_ends_at")
  trialEndedNotifiedAt DateTime? @map("trial_ended_notified_at")
  trialDeleteWarnedAt  DateTime? @map("trial_delete_warned_at")
  signupSource         String?   @map("signup_source") @db.VarChar(20)
  signupPlatform       String?   @map("signup_platform") @db.VarChar(10)
  partnerId            String?   @map("partner_id") @db.VarChar(25)

  num_assistant Int @default(1)

  serviceVariant  ServiceVariant @default(self) @map("service_variant")
  managedRegion   String?        @map("managed_region") @db.VarChar(30)
  storagePerAgent Int?           @map("storage_per_agent")

  cpaResetDate DateTime? @map("cpa_reset_date")

  docPagesPerMonth Int? @map("doc_pages_per_month")
  docPagesUsed     Int  @default(0) @map("doc_pages_used")
  docPagesMonth    Int  @default(1) @map("doc_pages_month")

  graceStartedAt      DateTime? @map("grace_started_at")
  graceAlertSentAt    DateTime? @map("grace_alert_sent_at")
  softFreeConvertedAt DateTime? @map("soft_free_converted_at")

  booster_cpa                  Int       @default(0)
  booster_total                Int       @default(0)
  booster_expires_at           DateTime? @map("booster_expires_at")
  booster_expiry_alert_sent_at DateTime? @map("booster_expiry_alert_sent_at")

  storePurchaseToken String? @unique @map("store_purchase_token") @db.VarChar(512)
  storeAccountKey    String? @unique @map("store_account_key") @db.VarChar(64)

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  boosterPurchases BoosterPurchase[]

  @@index([status])
  @@index([booster_expires_at])
  @@map("subscription")
}

model BoosterPurchase {
  id                      String    @id @default(cuid()) @db.VarChar(25)
  userId                  String    @db.VarChar(25)
  packCode                String    @map("pack_code") @db.VarChar(20)
  cpaAmount               Int       @map("cpa_amount")
  pricePaid               Decimal   @map("price_paid") @db.Decimal(10, 2)
  currency                String    @db.VarChar(3)
  purchasedAt             DateTime  @default(now()) @map("purchased_at")
  expiresAt               DateTime  @map("expires_at")
  expiredAt               DateTime? @map("expired_at")
  refundedAt              DateTime? @map("refunded_at")

  subscription Subscription @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purchasedAt])
  @@index([expiresAt])
  @@map("booster_purchases")
}

model StoreTransaction {
  id             String                  @id @default(cuid()) @db.VarChar(25)
  store          PaymentPlatform
  kind           StoreTransactionKind
  orderId        String                  @map("order_id") @db.VarChar(100)
  purchaseToken  String                  @map("purchase_token") @db.VarChar(512)
  linkedToken    String?                 @map("linked_token") @db.VarChar(512)
  chainRoot      String?                 @map("chain_root") @db.VarChar(512)
  productId      String                  @map("product_id") @db.VarChar(100)
  expiryTime     DateTime?               @map("expiry_time")
  userId         String                  @map("user_id") @db.VarChar(25)
  outcome        StoreTransactionOutcome
  refundedAt     DateTime?               @map("refunded_at")
  acknowledgedAt DateTime?               @map("acknowledged_at")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@unique([store, orderId])
  @@index([purchaseToken])
  @@index([linkedToken])
  @@index([userId, kind, createdAt])
  @@index([userId, chainRoot])
  @@map("store_transactions")
}

enum StoreTransactionKind {
  subscription
  pass
}

enum StoreTransactionOutcome {
  granted
  refused_double
  refused_ineligible
  ignored
}

model ManagedRegionConfig {
  id       Int    @id @default(autoincrement())
  regionId String @unique @map("region_id") @db.VarChar(30) // e.g. 'germanywestcentral'

  openaiApiKey   String @map("openai_api_key") @db.Text
  openaiEndpoint String @map("openai_endpoint") @db.VarChar(200)

  searchApiKey   String? @map("search_api_key") @db.Text
  searchEndpoint String? @map("search_endpoint") @db.VarChar(200)

  docIntelligenceKey      String? @map("doc_intelligence_key") @db.Text
  docIntelligenceEndpoint String? @map("doc_intelligence_endpoint") @db.VarChar(200)

  speechApiKey   String? @map("speech_api_key") @db.Text
  speechEndpoint String? @map("speech_endpoint") @db.VarChar(200)
  speechRegion   String? @map("speech_region") @db.VarChar(50)

  speechHdApiKey   String? @map("speech_hd_api_key") @db.Text
  speechHdEndpoint String? @map("speech_hd_endpoint") @db.VarChar(200)
  speechHdRegion   String? @map("speech_hd_region") @db.VarChar(50) // e.g. 'swedencentral'

  realtimeApiKey      String? @map("realtime_api_key") @db.Text
  realtimeEndpoint    String? @map("realtime_endpoint") @db.VarChar(200)
  realtimeDeployment  String? @map("realtime_deployment") @db.VarChar(100)
  realtimeApiVersion  String? @map("realtime_api_version") @db.VarChar(50) // e.g. '2025-04-01-preview'
  // e.g. {"gpt-realtime-1.5":"gpt-realtime-1-5","gpt-realtime-2.1":"gpt-realtime-2-1","gpt-realtime-2.1-mini":"gpt-realtime-2-1-mini"}
  realtimeDeployments String? @map("realtime_deployments") @db.Text

  blobConnectionString String? @map("blob_connection_string") @db.Text
  blobContainerName    String? @map("blob_container_name") @db.VarChar(100) // e.g. 'managed-switzerlandnorth'

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("managed_region_config")
}

model AiConnection {
  id         String  @id @default(cuid())
  name       String  @db.VarChar(100)
  kind       String  @db.VarChar(30) // 'azure' | 'openai_compatible' | 'anthropic'
  baseUrl    String  @map("base_url") @db.VarChar(500)
  apiKey     String  @map("api_key") @db.Text
  headers    String? @db.Text
  apiVersion String? @map("api_version") @db.VarChar(40)

  textModel       String  @map("text_model") @db.VarChar(200)
  imageModel      String? @map("image_model") @db.VarChar(200)
  embeddingModel  String? @map("embedding_model") @db.VarChar(200)
  maxOutputTokens Int?    @map("max_output_tokens")

  isDefault Boolean @default(false) @map("is_default")

  checkResult      Json?   @map("check_result")
  checkFingerprint String? @map("check_fingerprint") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ai_connections")
}

// ========================================
// ========================================

model KnowledgeGeneration {
  id             Int       @id @default(autoincrement())
  connectionId   String    @map("connection_id") @db.VarChar(30)
  embeddingModel String    @map("embedding_model") @db.VarChar(200)
  dimension      Int?
  status         String    @db.VarChar(20) // 'building' | 'active' | 'retired' | 'failed'
  createdAt      DateTime  @default(now()) @map("created_at")
  activatedAt    DateTime? @map("activated_at")

  chunks KnowledgeChunk[]

  @@index([status])
  @@map("knowledge_generations")
}

model KnowledgeChunk {
  id             String   @id @db.VarChar(120)
  generationId   Int      @map("generation_id")
  userId         String   @map("user_id") @db.VarChar(25)
  agentId        String   @map("agent_id") @db.VarChar(25)
  storageId      Int      @map("storage_id")
  ingestId       String   @map("ingest_id") @db.VarChar(40)
  ragSpace       String   @default("") @map("rag_space") @db.VarChar(20) // '' = Default
  title          String   @db.VarChar(500)
  chunkIndex     Int      @map("chunk_index")
  content        String   @db.Text
  embedding      Float[]  @db.Real
  embeddingModel String   @map("embedding_model") @db.VarChar(200)
  dimension      Int
  createdAt      DateTime @default(now()) @map("created_at")

  generation KnowledgeGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)
  storage    Storage             @relation(fields: [storageId], references: [id], onDelete: Cascade)

  @@index([generationId, agentId])
  @@index([storageId])
  @@index([userId])
  @@map("knowledge_chunks")
}

model BillingInfo {
  id String @id @db.VarChar(25)

  companyName        String? @map("company_name") @db.VarChar(200)
  vatNumber          String? @map("vat_number") @db.VarChar(50)
  registrationNumber String? @map("registration_number") @db.VarChar(50)

  companyAddress String? @map("company_address") @db.Text
  companyCity    String? @map("company_city") @db.VarChar(100)
  companyState   String? @map("company_state") @db.VarChar(100)
  companyZipCode String? @map("company_zip_code") @db.VarChar(20)
  companyCountry String? @map("company_country") @db.VarChar(100)

  useDifferentInvoiceAddress Boolean @default(false) @map("use_different_invoice_address")
  invoiceAddress             String? @map("invoice_address") @db.Text
  invoiceCity                String? @map("invoice_city") @db.VarChar(100)
  invoiceState               String? @map("invoice_state") @db.VarChar(100)
  invoiceZipCode             String? @map("invoice_zip_code") @db.VarChar(20)
  invoiceCountry             String? @map("invoice_country") @db.VarChar(100)

  contactPerson String? @map("contact_person") @db.VarChar(100)
  contactEmail  String? @map("contact_email") @db.VarChar(320)
  phone         String? @db.VarChar(40)

  invoiceEmail String? @map("invoice_email") @db.VarChar(320)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("billing_info")
}

model Invoice {
  id     String  @id @default(cuid()) @db.VarChar(25)
  userId String? @db.VarChar(25)

  invoiceNumber String @unique @map("invoice_number") @db.VarChar(50)

  planType     SubscriptionPlan @map("plan_type")
  billingCycle BillingCycle     @map("billing_cycle")

  invoiceType InvoiceType? @default(initial) @map("invoice_type")

  previousPlanType     SubscriptionPlan? @map("previous_plan_type")
  previousBillingCycle BillingCycle?     @map("previous_billing_cycle")

  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @db.VarChar(3)
  taxRate     Decimal? @map("tax_rate") @db.Decimal(5, 2)
  taxAmount   Decimal? @map("tax_amount") @db.Decimal(10, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(10, 2)

  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  status InvoiceStatus @default(draft)

  pdfPath  String? @map("pdf_path") @db.VarChar(500)
  fileName String? @map("file_name") @db.VarChar(255)

  issueDate DateTime  @map("issue_date")
  dueDate   DateTime  @map("due_date")
