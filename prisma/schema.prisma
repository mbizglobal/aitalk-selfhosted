  /// 'monthly' | 'daily'
  kind      String   @db.VarChar(10)
  validFor  DateTime @map("valid_for") @db.Date
  currency  String   @db.Char(3)
  rate      Decimal  @db.Decimal(12, 6)
  unit      Int
  source    String   @db.VarChar(200)
  fetchedAt DateTime @map("fetched_at")
  version   Int      @default(1)

  @@unique([kind, validFor, currency, version])
  @@index([currency, validFor])
  @@map("vat_fx_rate")
}

model VatFxRateManual {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String   @map("user_id") @db.VarChar(25)
  exportKey String   @default(cuid()) @map("export_key") @db.VarChar(64)
  date      DateTime @db.Date
  currency  String   @db.Char(3)
  rate      Decimal  @db.Decimal(12, 6)
  source    String   @db.VarChar(200)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, currency])
  @@unique([userId, exportKey])
  @@map("vat_fx_rate_manual")
}

// ========================================
// ========================================

model WorkProject {
  id               String    @id @default(cuid()) @db.VarChar(25)
  userId           String    @map("user_id") @db.VarChar(25)
  workflowId       String?   @unique @map("workflow_id") @db.VarChar(25)
  workflowLinkedAt DateTime? @map("workflow_linked_at")
  kind             String    @default("free") @db.VarChar(40)
  /// 'active' | 'archived'
  status           String    @default("active") @db.VarChar(10)
  settings         Bytes?    @db.ByteA
  modules          String[]  @default([])
  approvalSettings Json?     @map("approval_settings")
  agentId          String?   @map("agent_id") @db.VarChar(20)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflow      Workflow?          @relation(fields: [workflowId], references: [workflowId], onDelete: SetNull)
  agent         Agent?             @relation(fields: [agentId], references: [agentId], onDelete: SetNull)
  tasks         WorkTask[]
  sheets        DataSheet[]
  pairs         SheetRowPair[]
  files         WorkFile[]
  referencesOut ProjectReference[] @relation("ReferenceFrom")
  referencesIn  ProjectReference[] @relation("ReferenceTo")
  notes         WorkNote[]
  messages      WorkMessage[]

  @@unique([id, userId])
  @@index([userId])
  @@index([agentId])
  @@map("work_project")
}

model ProjectReference {
  id                 String   @id @default(cuid()) @db.VarChar(25)
  userId             String   @map("user_id") @db.VarChar(25)
  fromProjectId      String   @map("from_project_id") @db.VarChar(25)
  toProjectId        String   @map("to_project_id") @db.VarChar(25)
  sheets             String[]
  includeUnconfirmed Boolean  @default(false) @map("include_unconfirmed")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  from WorkProject @relation("ReferenceFrom", fields: [fromProjectId, userId], references: [id, userId], onDelete: Cascade)
  to   WorkProject @relation("ReferenceTo", fields: [toProjectId, userId], references: [id, userId], onDelete: Cascade)

  @@unique([fromProjectId, toProjectId])
  @@index([toProjectId])
  @@index([userId])
  @@map("project_reference")
}

model WorkTask {
  id                  String    @id @default(cuid()) @db.VarChar(25)
  projectId           String    @map("project_id") @db.VarChar(25)
  userId              String    @map("user_id") @db.VarChar(25)
  title               String    @db.VarChar(120)
  periodStart         DateTime? @map("period_start") @db.Date
  periodEnd           DateTime? @map("period_end") @db.Date
  status              String    @default("open") @db.VarChar(12)
  approvalRequest     Bytes?    @map("approval_request") @db.ByteA
  submittedAt         DateTime? @map("submitted_at")
  currentSubmissionId String?   @map("current_submission_id") @db.VarChar(25)
  createdAt           DateTime  @default(now()) @map("created_at")

  project     WorkProject      @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  submissions WorkSubmission[]
  files       WorkTaskFile[]
  notes       WorkNote[]
  messages    WorkMessage[]

  @@unique([id, projectId, userId])
  @@index([projectId])
  @@map("work_task")
}

model SheetRowKey {
  id             String @id @default(cuid()) @db.VarChar(25)
  projectId      String @map("project_id") @db.VarChar(25)
  userId         String @map("user_id") @db.VarChar(25)
  templateFamily String @map("template_family") @db.VarChar(120)
  keyHash        String @map("key_hash") @db.VarChar(64)
  rowId          String @map("row_id") @db.VarChar(25)

  row DataSheetRow @relation(fields: [rowId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)

  @@unique([projectId, templateFamily, keyHash])
  @@unique([rowId, templateFamily])
  @@map("sheet_row_key")
}

model SheetRowPair {
  id        String   @id @default(cuid()) @db.VarChar(25)
  projectId String   @map("project_id") @db.VarChar(25)
  userId    String   @map("user_id") @db.VarChar(25)
  fromRowId String   @map("from_row_id") @db.VarChar(25)
  toRowId   String   @map("to_row_id") @db.VarChar(25)
  kind      String   @db.VarChar(40)
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  project WorkProject  @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  from    DataSheetRow @relation("SheetRowPairFrom", fields: [fromRowId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)
  to      DataSheetRow @relation("SheetRowPairTo", fields: [toRowId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)

  @@unique([fromRowId, toRowId, kind])
  @@index([toRowId])
  @@map("sheet_row_pair")
}

model WorkNote {
  id        String   @id @default(cuid()) @db.VarChar(25)
  projectId String   @map("project_id") @db.VarChar(25)
  userId    String   @map("user_id") @db.VarChar(25)
  taskId    String?  @map("task_id") @db.VarChar(25)
  kind      String   @db.VarChar(12)
  body      Bytes    @db.ByteA
  status    String   @default("accepted") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project WorkProject @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  task    WorkTask?   @relation(fields: [taskId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)

  @@index([projectId, taskId])
  @@map("work_note")
}

model WorkMessage {
  id        String   @id @default(cuid()) @db.VarChar(25)
  projectId String   @map("project_id") @db.VarChar(25)
  userId    String   @map("user_id") @db.VarChar(25)
  taskId    String?  @map("task_id") @db.VarChar(25)
  /// 'user' | 'assistant'
  role      String   @db.VarChar(10)
  actor     String   @db.VarChar(40)
  body      Bytes    @db.ByteA
  createdAt DateTime @default(now()) @map("created_at")

  project WorkProject @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  task    WorkTask?   @relation(fields: [taskId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)

  @@index([projectId, taskId, createdAt])
  @@map("work_message")
}

model WorkEvent {
  id           String   @id @default(cuid()) @db.VarChar(25)
  userId       String   @map("user_id") @db.VarChar(25)
  projectId    String?  @map("project_id") @db.VarChar(25)
  sheetId      String?  @map("sheet_id") @db.VarChar(25)
  rowId        String?  @map("row_id") @db.VarChar(25)
  taskId       String?  @map("task_id") @db.VarChar(25)
  submissionId String?  @map("submission_id") @db.VarChar(25)
  fileId       String?  @map("file_id") @db.VarChar(25)
  noteId       String?  @map("note_id") @db.VarChar(25)
  actor        String   @db.VarChar(120)
  action       String   @db.VarChar(20)
  payload      Bytes?   @db.ByteA
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@map("work_event")
}

model WorkSubmission {
  id          String   @id @default(cuid()) @db.VarChar(25)
  taskId      String   @map("task_id") @db.VarChar(25)
  projectId   String   @map("project_id") @db.VarChar(25)
  userId      String   @map("user_id") @db.VarChar(25)
  number      Int
  submittedAt DateTime @default(now()) @map("submitted_at")
  result      Bytes    @db.ByteA
  preparedBy  String?  @map("prepared_by") @db.VarChar(80)
  approvedBy  String?  @map("approved_by") @db.VarChar(80)

  task         WorkTask               @relation(fields: [taskId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)
  proofs       WorkSubmissionFile[]
  sources      WorkSubmissionSource[]
  refAckDigest String?                @map("ref_ack_digest") @db.VarChar(64)

  @@unique([taskId, number])
  @@unique([id, projectId, userId])
  @@map("work_submission")
}

model WorkFile {
  id           String   @id @default(cuid()) @db.VarChar(25)
  projectId    String   @map("project_id") @db.VarChar(25)
  userId       String   @map("user_id") @db.VarChar(25)
  /// 'receipt' · 'bank_csv' · 'report' · 'page_image' · 'other'
  kind         String   @db.VarChar(20)
  parentFileId String?  @map("parent_file_id") @db.VarChar(25)
  blobRegion   String   @map("blob_region") @db.VarChar(30)
  blobPath     String   @map("blob_path") @db.VarChar(500)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  sha256       String   @db.Char(64)
  payload      Bytes    @db.ByteA
  readText     Bytes?   @map("read_text") @db.ByteA
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  project WorkProject          @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  parent  WorkFile?            @relation("WorkFileDerived", fields: [parentFileId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)
  derived WorkFile[]           @relation("WorkFileDerived")
  tasks   WorkTaskFile[]
  proofs  WorkSubmissionFile[]

  @@unique([projectId, sha256])
  @@unique([id, projectId, userId])
  @@map("work_file")
}

model WorkTaskFile {
  id        String   @id @default(cuid()) @db.VarChar(25)
  taskId    String   @map("task_id") @db.VarChar(25)
  fileId    String   @map("file_id") @db.VarChar(25)
  projectId String   @map("project_id") @db.VarChar(25)
  userId    String   @map("user_id") @db.VarChar(25)
  createdAt DateTime @default(now()) @map("created_at")

  task WorkTask @relation(fields: [taskId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)
  file WorkFile @relation(fields: [fileId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)

  @@unique([taskId, fileId])
  @@index([fileId])
  @@map("work_task_file")
}

model WorkSubmissionSource {
  id              String @id @default(cuid()) @db.VarChar(25)
  submissionId    String @map("submission_id") @db.VarChar(25)
  projectId       String @map("project_id") @db.VarChar(25)
  userId          String @map("user_id") @db.VarChar(25)
  sourceProjectId String @map("source_project_id") @db.VarChar(25)
  sourceTaskId    String @map("source_task_id") @db.VarChar(25)

  submission WorkSubmission @relation(fields: [submissionId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)

  @@unique([submissionId, sourceTaskId])
  @@index([sourceTaskId])
  @@map("work_submission_source")
}

model WorkSubmissionFile {
  id           String   @id @default(cuid()) @db.VarChar(25)
  submissionId String   @map("submission_id") @db.VarChar(25)
  fileId       String   @map("file_id") @db.VarChar(25)
  projectId    String   @map("project_id") @db.VarChar(25)
  userId       String   @map("user_id") @db.VarChar(25)
  attachedAt   DateTime @default(now()) @map("attached_at")

  submission WorkSubmission @relation(fields: [submissionId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)
  file       WorkFile       @relation(fields: [fileId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)

  @@unique([submissionId, fileId])
  @@index([fileId])
  @@map("work_submission_file")
}
