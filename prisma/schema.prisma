model DataSheet {
  id             String   @id @default(cuid()) @db.VarChar(25)
  agentId        String?  @db.VarChar(20)
  userId         String?  @map("user_id") @db.VarChar(25)
  projectId      String?  @map("project_id") @db.VarChar(25)
  /// 'agent' | 'project'
  kind           String   @default("agent") @db.VarChar(10)
  template       String?  @db.VarChar(80)
  templateFamily String?  @map("template_family") @db.VarChar(80)
  name           String   @db.VarChar(255)
  description    String?  @db.Text
  schema         String   @db.Text
  sizeBytes      BigInt   @default(0) @map("size_bytes")
  rowCount       Int      @default(0) @map("row_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  agent       Agent?                   @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  project     WorkProject?             @relation(fields: [projectId, userId], references: [id, userId], onDelete: Cascade)
  rows        DataSheetRow[]           @relation("SheetRowsByKind")
  projectRows DataSheetRow[]           @relation("SheetRowsByProject")
  groupItems  WorkflowGroupDataSheet[]

  @@unique([agentId, name])
  @@unique([projectId, name])
  @@unique([id, kind])
  @@unique([id, projectId, userId])
  @@index([agentId])
  @@map("data_sheets")
}

model DataSheetRow {
  id          String   @id @default(cuid()) @db.VarChar(25)
  sheetId     String   @map("sheet_id") @db.VarChar(25)
  kind        String   @default("agent") @db.VarChar(10)
  projectId   String?  @map("project_id") @db.VarChar(25)
  userId      String?  @map("user_id") @db.VarChar(25)
  rowData     String   @map("row_data") @db.Text
  sealed      Bytes?   @db.ByteA
  confirmed   Boolean?
  confirmedBy String?  @map("confirmed_by") @db.VarChar(80)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sheet        DataSheet      @relation("SheetRowsByKind", fields: [sheetId, kind], references: [id, kind], onDelete: Cascade)
  projectSheet DataSheet?     @relation("SheetRowsByProject", fields: [sheetId, projectId, userId], references: [id, projectId, userId], onDelete: Cascade)
  keys         SheetRowKey[]
  pairsFrom    SheetRowPair[] @relation("SheetRowPairFrom")
  pairsTo      SheetRowPair[] @relation("SheetRowPairTo")

  @@unique([id, projectId, userId])
  @@index([sheetId])
  @@index([sheetId, createdAt], map: "idx_sheet_created")
  @@index([sheetId, updatedAt], map: "idx_sheet_updated")
  @@map("data_sheet_rows")
}

