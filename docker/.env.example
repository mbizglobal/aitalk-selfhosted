# AI Talk Self-hosted settings — copy this file to .env and fill it in. .env is secret (never put it in a repository or an image)

# ── Required ─────────────────────────────────────────────
# The address users open (mail links · login return address). Absolute http(s) URL without a trailing / — e.g. https://ai.example.com
NEXTAUTH_URL=
# Signs login sessions — at least 32 characters. Create: openssl rand -base64 32
NEXTAUTH_SECRET=
# Master key for stored secrets (AI keys · connection passwords) — exactly 64 hex characters. Create: openssl rand -hex 32
# If you lose it the stored secrets cannot be read — keep it with the database backup
ENCRYPTION_SECRET=
# Database password (the db container in docker-compose) — letters and digits only (it goes into the database URL as is — @ : / ? # % break it)
# Create: openssl rand -hex 24
POSTGRES_PASSWORD=

# App image tag — exactly as received (or loaded with docker load). Upgrade = change it to the new tag and docker compose up -d
# e.g. aitalk-selfhosted:1.0.0 (an offline bundle states its tag here)
AITALK_IMAGE=

# ── Administrators ───────────────────────────────────────────
# ── Mail (your SMTP) — password reset · team invitations ──
SMTP_HOST=
# Empty = 587 (465 with SMTP_SECURE=true)
SMTP_PORT=
# true for implicit TLS on 465 · empty = false (587 + STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_FROM_NAME=
# SMTP_OPS_REPORT_TO=

# ── Optional ─────────────────────────────────────────────
# Product name · mail footer (defaults: AI Talk · none)
# BRAND_NAME=
# BRAND_FOOTER=
# Address that receives feedback — without it there is no feedback button
# FEEDBACK_EMAIL=
# Google sign-in — enabled only when both are set
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Enterprise license — a file path or the value (not both). Mount the file read-only
# AITALK_LICENSE_FILE=
# AITALK_LICENSE=
# Store files in S3-compatible storage (default = volume /data/files)
# FILE_STORE=s3
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# Document search — default pgvector (this database). Use http for your own search server
# KNOWLEDGE_STORE=http
# KNOWLEDGE_HTTP_URL=
# KNOWLEDGE_HTTP_SECRET=
# KNOWLEDGE_HTTP_INSTALL_ID=
# Run an AI model on this server (when there is no company AI server) — see the ollama notes in docker-compose.yml
# COMPOSE_PROFILES=ollama
# OLLAMA_CONTEXT_LENGTH=16384
# Database name · user · app port (listens on 127.0.0.1 only)
# POSTGRES_USER=aitalk
# POSTGRES_DB=aitalk
# APP_PORT=3000
# When running more app containers, on all but one: AITALK_BACKGROUND_JOBS=off
